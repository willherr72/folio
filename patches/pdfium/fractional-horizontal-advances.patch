+void CPDF_CIDFont::LoadPreciseWidths(const CPDF_Array* widths) {
+  // Reject malformed range structure as a whole, retaining legacy fallback.
+  std::vector<PreciseWidthRange> ranges;
+  auto precise = [](float value) -> std::optional<float> {
+    return std::isfinite(value) && value >= 0 && value <= 65535
+               ? std::optional<float>(value) : std::nullopt;
+  };
+  size_t index = 0;
+  while (index < widths->size()) {
+    if (!widths->GetNumberAt(index) || index + 1 >= widths->size()) {
+      return;
+    }
+    const int first = widths->GetIntegerAt(index++);
+    if (first < 0 || first > 65535) {
+      return;
+    }
+    if (auto values = widths->GetArrayAt(index)) {
+      if (values->size() > 65536u - first) {
+        return;
+      }
+      for (size_t offset = 0; offset < values->size(); ++offset) {
+        const auto code = static_cast<uint16_t>(first + offset);
+        ranges.push_back({code, code, precise(values->GetFloatAt(offset))});
+      }
+      ++index;
+    } else {
+      if (!widths->GetNumberAt(index) || index + 1 >= widths->size()) {
+        return;
+      }
+      const int last = widths->GetIntegerAt(index++);
+      if (last < first || last > 65535) {
+        return;
+      }
+      ranges.push_back({static_cast<uint16_t>(first), static_cast<uint16_t>(last),
+                        precise(widths->GetFloatAt(index++))});
+    }
+  }
+  precise_widths_ = std::move(ranges);
+}
+
+float CPDF_CIDFont::GetCharAdvance(uint32_t charcode) {
+  if (charcode < 0x80 && ansi_widths_fixed_) {
+    return GetCharWidth(charcode);
+  }
+  const uint16_t cid = CIDFromCharCode(charcode);
+  for (const auto& range : precise_widths_) {
+    if (cid >= range.first && cid <= range.last) {
+      return range.width ? *range.width : GetCharWidth(charcode);
+    }
+  }
+  // Invalid/unsupported W entries must not fall through to a different DW.
+  auto ranges = fxcrt::reinterpret_span<const LowHighVal>(pdfium::span(width_list_));
+  for (const auto& range : ranges) {
+    if (IsMetricForCID(range, cid)) {
+      return range.val;
+    }
+  }
+  return precise_default_width_ ? *precise_default_width_ : GetCharWidth(charcode);
+}
