+float FiniteBorderWidth(const CPDF_Object* width, int legacy_width) {
+  if (width && width->IsNumber()) {
+    const float value = width->GetNumber();
+    // Keep legacy fallbacks for invalid or out-of-range widths. This also
+    // bounds later doubled/inset border arithmetic to finite values.
+    if (std::isfinite(value) && value >= 0.0f &&
+        value < static_cast<float>(std::numeric_limits<int>::max())) {
+      return value;
+    }
+  }
+  return static_cast<float>(legacy_width);
+}
+
+}  // namespace
