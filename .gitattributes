* text=auto
*.rs text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.pdf binary
*.png binary
*.ico binary

# Preserve the bundled upstream font license, including its original whitespace.
tests/fixtures/corpus/fonts/LICENSE_DEJAVU.txt -text -whitespace
# These pinned assets are verified byte-for-byte against their provenance.
tests/fixtures/shaped-text/*.ttf binary
tests/fixtures/shaped-text/*.txt -text -whitespace
tests/fixtures/shaped-text/unicode/*.txt -text -whitespace
